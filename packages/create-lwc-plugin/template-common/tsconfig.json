{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ESNext", "DOM"],
		"moduleResolution": "Node",
		"strict": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		// Only the types referenced explicitly by the sources, so that generating
		// the bundled declarations never picks up unrelated ambient @types
		// packages that happen to be installed further up the tree.
		"types": [],
		"declaration": true,
		"declarationDir": "typings",
		"emitDeclarationOnly": true
	},
	"include": ["src"]
}
