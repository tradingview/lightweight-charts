{
    "name": "lightweight-charts-plugin-examples",
    "private": true,
    "type": "module",
    "scripts": {
        "build:deps": "pnpm --filter @tradingview/lwc-toolkit --filter \"@tradingview/lwc-plugin-*\" build",
        "build": "pnpm build:deps && tsc",
        "compile": "pnpm build:deps && tsc && node compile.mjs",
        "dev": "pnpm build:deps && vite --config src/vite.config.js",
        "build:examples:site": "pnpm build:deps && vite build --config src/vite.config.js && node build-website.mjs"
    },
    "devDependencies": {
        "typescript": "5.9.3",
        "vite": "7.2.0"
    },
    "dependencies": {
        "@tradingview/lwc-plugin-vertical-line": "workspace:*",
        "@tradingview/lwc-toolkit": "workspace:*",
        "dts-bundle-generator": "9.5.1",
        "fancy-canvas": "2.1.0",
        "globby": "14.1.0",
        "lightweight-charts": "workspace:*"
    }
}
